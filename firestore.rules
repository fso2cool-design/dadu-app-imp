rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if current authenticated user is Super Admin
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'johanrovian90@gmail.com' ||
        request.auth.token.email == 'fso2cool@gmail.com'
      );
    }

    match /users/{userId} {
      // Allow reading user profiles (admin can list all users to manage accounts)
      allow list: if request.auth != null && (isSuperAdmin() || request.auth.uid == userId);
      allow get: if request.auth != null && (isSuperAdmin() || request.auth.uid == userId);
      
      // Allow create user profile during onboarding/signup
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Allow update by owner (without privilege escalation) or by Super Admin
      allow update: if request.auth != null && (
        isSuperAdmin() || 
        (request.auth.uid == userId && 
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'accountStatus']) 
           || (resource.data.role == request.resource.data.role && resource.data.accountStatus == request.resource.data.accountStatus)))
      );
      
      // Allow Super Admin to delete/purge accounts to manage free quota
      allow delete: if request.auth != null && isSuperAdmin();

      // Granular subcollection validation
      match /classes/{classId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
        allow delete: if request.auth != null && (isSuperAdmin() || (request.auth.uid == userId && resource.data.isArchived != true));
        allow create: if request.auth != null && (request.auth.uid == userId || isSuperAdmin())
          && request.resource.data.name is string
          && request.resource.data.academicYearId is string;
        // Enforce academicYearId immutability on update to preserve historical academic ties
        allow update: if request.auth != null && (request.auth.uid == userId || isSuperAdmin())
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['academicYearId'])
              || resource.data.academicYearId == request.resource.data.academicYearId);
      }

      match /students/{studentId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
        allow delete: if request.auth != null && (isSuperAdmin() || (request.auth.uid == userId && resource.data.isArchived != true));
        allow create: if request.auth != null && (request.auth.uid == userId || isSuperAdmin())
          && request.resource.data.fullName is string;
        allow update: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      }

      match /subjects/{subjectId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
        allow delete: if request.auth != null && (isSuperAdmin() || (request.auth.uid == userId && resource.data.isArchived != true));
        allow create, update: if request.auth != null && (request.auth.uid == userId || isSuperAdmin())
          && request.resource.data.name is string;
      }

      match /teachingAssignments/{assignmentId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
        allow delete: if request.auth != null && (isSuperAdmin() || (request.auth.uid == userId && resource.data.isArchived != true));
        allow create: if request.auth != null && (request.auth.uid == userId || isSuperAdmin())
          && request.resource.data.academicYearId is string
          && request.resource.data.classId is string
          && request.resource.data.subjectId is string;
        // Enforce academicYearId, classId, and subjectId immutability on update to preserve historical academic ties
        allow update: if request.auth != null && (request.auth.uid == userId || isSuperAdmin())
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['academicYearId', 'classId', 'subjectId'])
              || (resource.data.academicYearId == request.resource.data.academicYearId
                  && resource.data.classId == request.resource.data.classId
                  && resource.data.subjectId == request.resource.data.subjectId));
      }

      match /academicYears/{academicYearId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
        allow delete: if request.auth != null && (isSuperAdmin() || (request.auth.uid == userId && resource.data.isArchived != true && resource.data.isActive != true));
        allow create: if request.auth != null && (request.auth.uid == userId || isSuperAdmin())
          && request.resource.data.label is string;
        allow update: if request.auth != null && (request.auth.uid == userId || isSuperAdmin())
          && (resource.data.isArchived != true || isSuperAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isArchived']));
      }

      match /enrollments/{enrollmentId} {
        allow read, delete: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
        allow create: if request.auth != null && (request.auth.uid == userId || isSuperAdmin())
          && request.resource.data.academicYearId is string
          && request.resource.data.classId is string
          && request.resource.data.studentId is string;
        // Enforce immutability of academicYearId, classId, and studentId on normal updates to preserve identity and historical ties.
        // Governed recovery/re-link allows studentId correction ONLY if academicYearId and classId are unchanged and relinkedAt is supplied.
        allow update: if request.auth != null && (request.auth.uid == userId || isSuperAdmin())
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['academicYearId', 'classId', 'studentId'])
              || (resource.data.academicYearId == request.resource.data.academicYearId
                  && resource.data.classId == request.resource.data.classId
                  && (resource.data.studentId == request.resource.data.studentId || ('relinkedAt' in request.resource.data))))
          && (!('status' in request.resource.data) || request.resource.data.status in ['ACTIVE', 'TRANSFERRED', 'GRADUATED', 'DROPOUT', 'ARCHIVED']);
      }

      match /scores/{scoreId} {
        allow read, delete: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
        allow create: if request.auth != null && (request.auth.uid == userId || isSuperAdmin())
          && request.resource.data.assessmentItemId is string
          && request.resource.data.studentId is string
          && (!('score' in request.resource.data) || (request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 100));
        allow update: if request.auth != null && (request.auth.uid == userId || isSuperAdmin())
          && (!('score' in request.resource.data) || (request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 100))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['assessmentItemId'])
              || resource.data.assessmentItemId == request.resource.data.assessmentItemId)
          && ((!request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentId'])
              || resource.data.studentId == request.resource.data.studentId)
              || ('relinkedAt' in request.resource.data));
      }

      match /meetings/{meetingId} {
        allow read, delete: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
        allow create: if request.auth != null && (request.auth.uid == userId || isSuperAdmin())
          && request.resource.data.teachingAssignmentId is string
          && request.resource.data.classId is string
          && request.resource.data.subjectId is string
          && request.resource.data.academicYearId is string
          && request.resource.data.meetingNumber is number
          && (!('semester' in request.resource.data) || request.resource.data.semester in ['GANJIL', 'GENAP']);
        allow update: if request.auth != null && (request.auth.uid == userId || isSuperAdmin())
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['teachingAssignmentId', 'classId', 'subjectId', 'academicYearId', 'meetingNumber', 'semester'])
              || (resource.data.teachingAssignmentId == request.resource.data.teachingAssignmentId 
                  && resource.data.classId == request.resource.data.classId
                  && resource.data.subjectId == request.resource.data.subjectId
                  && resource.data.academicYearId == request.resource.data.academicYearId
                  && resource.data.meetingNumber == request.resource.data.meetingNumber
                  && (!('semester' in resource.data) || resource.data.semester == request.resource.data.semester)));
      }

      match /attendanceRecords/{recordId} {
        allow read, delete: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
        allow create: if request.auth != null && (request.auth.uid == userId || isSuperAdmin())
          && request.resource.data.studentId is string
          && (!('status' in request.resource.data) || request.resource.data.status in ['PRESENT', 'SICK', 'PERMITTED', 'ABSENT', 'DISPENSATION'])
          && (!('meetingId' in request.resource.data) || request.resource.data.meetingId == null || request.resource.data.meetingId is string);
        allow update: if request.auth != null && (request.auth.uid == userId || isSuperAdmin())
          && (!('status' in request.resource.data) || request.resource.data.status in ['PRESENT', 'SICK', 'PERMITTED', 'ABSENT', 'DISPENSATION'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentId', 'meetingId', 'academicYearId', 'classId', 'subjectId', 'teachingAssignmentId'])
              || (resource.data.studentId == request.resource.data.studentId
                  && (!('academicYearId' in resource.data) || resource.data.academicYearId == request.resource.data.academicYearId)));
      }

      match /dailyAttendanceSessions/{sessionId} {
        allow read, delete: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
        allow create: if request.auth != null && (request.auth.uid == userId || isSuperAdmin())
          && request.resource.data.classId is string
          && request.resource.data.academicYearId is string
          && request.resource.data.date is string;
        allow update: if request.auth != null && (request.auth.uid == userId || isSuperAdmin())
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['classId', 'academicYearId', 'date'])
              || (resource.data.classId == request.resource.data.classId
                  && resource.data.academicYearId == request.resource.data.academicYearId
                  && resource.data.date == request.resource.data.date));
      }

      match /dailyAttendanceRecords/{recordId} {
        allow read, delete: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
        allow create: if request.auth != null && (request.auth.uid == userId || isSuperAdmin())
          && request.resource.data.studentId is string
          && (!('status' in request.resource.data) || request.resource.data.status in ['PRESENT', 'SICK', 'PERMITTED', 'ABSENT', 'DISPENSATION']);
        allow update: if request.auth != null && (request.auth.uid == userId || isSuperAdmin())
          && (!('status' in request.resource.data) || request.resource.data.status in ['PRESENT', 'SICK', 'PERMITTED', 'ABSENT', 'DISPENSATION'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentId', 'classId', 'academicYearId', 'date', 'sessionId'])
              || resource.data.studentId == request.resource.data.studentId);
      }

      // Assessment Columns & Configuration
      match /assessmentItems/{itemId} {
        allow read, delete: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
        allow create: if request.auth != null && (request.auth.uid == userId || isSuperAdmin())
          && request.resource.data.academicYearId is string
          && request.resource.data.classId is string
          && (!('subjectId' in request.resource.data) || request.resource.data.subjectId is string)
          && (!('teachingAssignmentId' in request.resource.data) || request.resource.data.teachingAssignmentId is string)
          && (!('semester' in request.resource.data) || request.resource.data.semester in ['GANJIL', 'GENAP'])
          && (!('weight' in request.resource.data) || request.resource.data.weight >= 0)
          && (!('maxScore' in request.resource.data) || (request.resource.data.maxScore > 0 && request.resource.data.maxScore <= 100));
        allow update: if request.auth != null && (request.auth.uid == userId || isSuperAdmin())
          && (!('weight' in request.resource.data) || request.resource.data.weight >= 0)
          && (!('maxScore' in request.resource.data) || (request.resource.data.maxScore > 0 && request.resource.data.maxScore <= 100))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['academicYearId', 'semester', 'teachingAssignmentId', 'classId', 'subjectId'])
              || (resource.data.academicYearId == request.resource.data.academicYearId
                  && (!('classId' in resource.data) || resource.data.classId == request.resource.data.classId)
                  && (!('semester' in resource.data) || resource.data.semester == request.resource.data.semester)));
      }

      // Student Notes / Guidance
      match /studentNotes/{noteId} {
        allow read, delete: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
        allow create: if request.auth != null && (request.auth.uid == userId || isSuperAdmin())
          && request.resource.data.studentId is string
          && request.resource.data.classId is string
          && request.resource.data.academicYearId is string;
        allow update: if request.auth != null && (request.auth.uid == userId || isSuperAdmin())
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['academicYearId', 'classId'])
              || (resource.data.academicYearId == request.resource.data.academicYearId && resource.data.classId == request.resource.data.classId))
          && ((!request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentId'])
              || resource.data.studentId == request.resource.data.studentId)
              || ('relinkedAt' in request.resource.data));
      }

      // Subject Teacher Attendance Records recorded by Homeroom Teacher
      match /teacherAttendanceRecords/{recordId} {
        allow read, delete: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
        allow create: if request.auth != null && (request.auth.uid == userId || isSuperAdmin())
          && request.resource.data.academicYearId is string
          && request.resource.data.semester in ['GANJIL', 'GENAP']
          && request.resource.data.classId is string
          && request.resource.data.date is string
          && request.resource.data.teachingAssignmentId is string
          && (!('status' in request.resource.data) || request.resource.data.status in ['HADIR', 'SAKIT', 'IZIN', 'ALPA', 'DINAS']);
        allow update: if request.auth != null && (request.auth.uid == userId || isSuperAdmin())
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['academicYearId', 'semester', 'classId', 'date', 'teachingAssignmentId'])
              || (resource.data.academicYearId == request.resource.data.academicYearId
                  && resource.data.semester == request.resource.data.semester
                  && resource.data.classId == request.resource.data.classId
                  && resource.data.date == request.resource.data.date
                  && resource.data.teachingAssignmentId == request.resource.data.teachingAssignmentId))
          && (!('status' in request.resource.data) || request.resource.data.status in ['HADIR', 'SAKIT', 'IZIN', 'ALPA', 'DINAS']);
      }

      match /teacherMonthlyAttendance/{recordId} {
        allow read, delete: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
        allow create: if request.auth != null && (request.auth.uid == userId || isSuperAdmin())
          && request.resource.data.classId is string
          && request.resource.data.academicYearId is string
          && request.resource.data.semester in ['GANJIL', 'GENAP']
          && request.resource.data.year is number
          && request.resource.data.month is number;
        allow update: if request.auth != null && (request.auth.uid == userId || isSuperAdmin())
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['classId', 'academicYearId', 'semester', 'year', 'month'])
              || (resource.data.classId == request.resource.data.classId
                  && resource.data.academicYearId == request.resource.data.academicYearId
                  && resource.data.semester == request.resource.data.semester
                  && resource.data.year == request.resource.data.year
                  && resource.data.month == request.resource.data.month));
      }

      match /classSchedules/{scheduleId} {
        allow read, delete: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
        allow create: if request.auth != null && (request.auth.uid == userId || isSuperAdmin())
          && request.resource.data.classId is string
          && request.resource.data.academicYearId is string
          && request.resource.data.semester in ['GANJIL', 'GENAP'];
        allow update: if request.auth != null && (request.auth.uid == userId || isSuperAdmin())
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['classId', 'academicYearId', 'semester'])
              || (resource.data.classId == request.resource.data.classId
                  && resource.data.academicYearId == request.resource.data.academicYearId
                  && resource.data.semester == request.resource.data.semester));
      }

      // School, Document, Preference & Attendance Settings
      match /settings/{settingId} {
        allow read, write, delete: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      }

      // Custom fields defined for students
      match /studentCustomFields/{fieldId} {
        allow read, write, delete: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      }
    }

    // Feedback and Bug Reports collection
    match /feedbacks/{feedbackId} {
      // Any authenticated user can submit feedback with their own uid
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // User can read their own feedback, super admin can read all
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isSuperAdmin());
      // Only Super Admin can update status, write reply, or delete
      allow update, delete: if request.auth != null && isSuperAdmin();
    }

    // Shared Reports (Public Read-Only with Token / Passcode, Authenticated Owner Write/Revoke)
    match /sharedReports/{reportId} {
      // Allow public get if document exists, is not revoked, and is not expired
      allow get: if resource.data.isRevoked != true
        && (!('expiresAt' in resource.data) || resource.data.expiresAt == null || !(resource.data.expiresAt is timestamp) || request.time < resource.data.expiresAt);

      // Listing is restricted to the creator or Super Admin
      allow list: if request.auth != null && (request.auth.uid == resource.data.userId || isSuperAdmin());

      // Authenticated teacher can create a shared report with their own userId
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == reportId
        && request.resource.data.isRevoked == false
        && request.resource.data.viewCount == 0;

      // Owner or Super Admin can revoke/update, or viewer can increment viewCount & lastViewedAt
      allow update: if (
        (request.auth != null && (request.auth.uid == resource.data.userId || isSuperAdmin())
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'id', 'reportType']))
        ) ||
        (resource.data.isRevoked != true
          && (!('expiresAt' in resource.data) || resource.data.expiresAt == null || !(resource.data.expiresAt is timestamp) || request.time < resource.data.expiresAt)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount', 'lastViewedAt'])
        )
      );

      // Only owner or Super Admin can delete
      allow delete: if request.auth != null && (request.auth.uid == resource.data.userId || isSuperAdmin());
    }

    // Allow Super Admin to query collection groups across workspaces for orphan detection
    match /{path=**}/classes/{docId} {
      allow read: if isSuperAdmin();
    }
    match /{path=**}/students/{docId} {
      allow read: if isSuperAdmin();
    }
    match /{path=**}/academicYears/{docId} {
      allow read: if isSuperAdmin();
    }
    match /{path=**}/subjects/{docId} {
      allow read: if isSuperAdmin();
    }
    match /{path=**}/teachingAssignments/{docId} {
      allow read: if isSuperAdmin();
    }
    match /{path=**}/dailyAttendanceSessions/{docId} {
      allow read: if isSuperAdmin();
    }
    match /{path=**}/attendanceRecords/{docId} {
      allow read: if isSuperAdmin();
    }
    match /{path=**}/teacherAttendanceRecords/{docId} {
      allow read: if isSuperAdmin();
    }
    match /{path=**}/studentCustomFields/{docId} {
      allow read: if isSuperAdmin();
    }
    match /{path=**}/enrollments/{docId} {
      allow read: if isSuperAdmin();
    }
    match /{path=**}/meetings/{docId} {
      allow read: if isSuperAdmin();
    }
    match /{path=**}/scores/{docId} {
      allow read: if isSuperAdmin();
    }
    match /{path=**}/assessmentItems/{docId} {
      allow read: if isSuperAdmin();
    }
    match /{path=**}/studentNotes/{docId} {
      allow read: if isSuperAdmin();
    }
  }
}



