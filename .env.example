VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# Optional: Set to true if behind restrictive proxy/firewall that blocks WebChannel streaming
VITE_FIRESTORE_FORCE_LONG_POLLING=false
# App Check (reCAPTCHA Enterprise site key dari Google Cloud Console). Kosongkan = App Check nonaktif.
VITE_APPCHECK_SITE_KEY=
# Token debug lokal (isi setelah ambil dari console browser dev, daftarkan di Firebase Console > App Check).
VITE_APPCHECK_DEBUG_TOKEN=
